[Unit]
Description=Smart Cart Web Application
After=network.target graphical.target

[Service]
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/python3 /home/pi/smart_cart/app.py
WorkingDirectory=/home/pi/smart_cart
Restart=always
RestartSec=5
User=pi
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target
